/* styles_dark.tcss - Clew TUI dark theme */

/* Global styling */
Screen {
    background: #0d1117;
    color: #c9d1d9;
}

/* -- Status Bar -- */
StatusBar {
    dock: top;
    height: 3;
    background: #161b22;
    color: #c9d1d9;
    border-bottom: tall #238636;
}

/* -- Chat Log -- */
ChatLog {
    height: 1fr;
    background: #0d1117;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #238636;
}

/* -- Input Box -- */
InputBox {
    dock: bottom;
    height: 3;
    border: tall #238636;
    margin: 0 2 1 2;
    background: #161b22;
}

InputBox:focus {
    border: tall #238636;
    background: #161b22;
}

InputBox:focus-within {
    border: tall #238636;
}

/* -- Command Suggestions (inline, above input) -- */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #161b22;
    border: tall #238636;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #8b949e;
    padding: 0 1;
    text-style: italic;
}

/* -- Approval Modal -- */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: thick #ffa500;
    background: #161b22;
}

#approval-title {
    text-style: bold;
    color: #ffa500;
    margin-bottom: 1;
}

#approval-action {
    color: #c9d1d9;
}

#approval-summary {
    color: #8b949e;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    align: center middle;
}

#approval-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* -- Verification Modal (G4) -- */
VerificationModal {
    align: center middle;
}

#verify-box {
    width: 80%;
    max-width: 120;
    height: auto;
    max-height: 32;
    padding: 1 2;
    border: thick #58a6ff;
    background: #161b22;
}

#verify-title {
    text-style: bold;
    margin-bottom: 1;
}

#verify-grid {
    height: auto;
    margin-bottom: 1;
}

.verify-cell {
    width: 1fr;
    padding: 0 1;
}

#verify-meta {
    color: #8b949e;
    margin-bottom: 1;
}

#verify-summary {
    color: #c9d1d9;
    margin-bottom: 1;
}

#verify-issues {
    color: #ffa657;
    margin-bottom: 1;
}

#verify-suggestions {
    color: #79c0ff;
    margin-bottom: 1;
}

#verify-raw {
    color: #8b949e;
    margin-bottom: 1;
}

#verify-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#verify-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* -- Command Palette -- */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #161b22;
    border: tall #238636;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #238636 20%;
    color: #c9d1d9;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: tall #238636;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #8b949e;
    padding: 0 1;
    text-style: italic;
}

/* Animation utilities for widgets */
.animate-transition {
    /* transition: all 0.2s ease-in-out; */
}