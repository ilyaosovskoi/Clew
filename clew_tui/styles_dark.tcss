/* styles_dark.tcss - Clew TUI dark theme */

/* Define CSS variables on Screen */
Screen {
    --background: #0d1117;
    --surface: #161b22;
    --primary: #238636;
    --foreground: #c9d1d9;
    --muted: #8b949e;
    --border: #238636;
    --highlight: #f0f6fc;
}

/* Base styles with transitions for smooth animation */
Screen {
    background: var(--background);
    color: var(--foreground);
    transition: background 0.3s ease, color 0.3s ease;
}

/* -- Status Bar -- */
StatusBar {
    dock: top;
    height: 3;
    background: var(--surface);
    color: var(--foreground);
    border-bottom: tall var(--border);
    transition: background 0.3s ease, color 0.3s ease, border-bottom 0.3s ease;
}

/* -- Chat Log -- */
ChatLog {
    height: 1fr;
    background: var(--background);
    padding: 1 2;
    scrollbar-size: 1 1;
    transition: background 0.3s ease;
}

ChatLog:focus {
    scrollbar-color: var(--primary);
}

/* -- Input Box -- */
InputBox {
    dock: bottom;
    height: 3;
    border: tall var(--border);
    margin: 0 2 1 2;
    background: var(--surface);
    transition: border 0.3s ease, background 0.3s ease;
}

InputBox:focus {
    border: tall var(--primary);
    background: var(--surface);
}

InputBox:focus-within {
    border: tall var(--primary);
}

/* -- Command Suggestions (inline, above input) -- */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: var(--surface);
    border: tall var(--border);
    padding: 0 1;
    transition: background 0.3s ease, border 0.3s ease;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: var(--muted);
    padding: 0 1;
    text-style: italic;
    transition: color 0.3s ease;
}

/* -- Approval Modal -- */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: thick #ffa500; /* orange */
    background: var(--surface);
    transition: background 0.3s ease, border 0.3s ease;
}

#approval-title {
    text-style: bold;
    color: #ffa500;
    margin-bottom: 1;
}

#approval-action {
    color: var(--foreground);
}

#approval-summary {
    color: var(--muted);
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    align: center middle;
}

#approval-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* -- Command Palette -- */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: var(--surface);
    border: tall var(--border);
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: var(--primary) 20%;
    color: var(--foreground);
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: tall var(--border);
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: var(--muted);
    padding: 0 1;
    text-style: italic;
}

/* Animation utilities for widgets */
.animate-transition {
    transition: all 0.2s ease-in-out;
}

.fade-in {
    animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.slide-up {
    animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}