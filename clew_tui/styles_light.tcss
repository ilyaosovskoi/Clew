/* styles_light.tcss - Clew TUI light theme */

/* Global styling */
Screen {
    background: #ffffff;
    color: #24292f;
}

/* -- Status Bar -- */
StatusBar {
    dock: top;
    height: 3;
    background: #f6f8fa;
    color: #24292f;
    border-bottom: tall #2ea043;
}

/* -- Chat Log -- */
ChatLog {
    height: 1fr;
    background: #ffffff;
    padding: 1 2;
    scrollbar-size: 1 1;
}

ChatLog:focus {
    scrollbar-color: #2ea043;
}

/* -- Input Box -- */
InputBox {
    dock: bottom;
    height: 3;
    border: tall #2ea043;
    margin: 0 2 1 2;
    background: #f6f8fa;
}

InputBox:focus {
    border: tall #2ea043;
    background: #f6f8fa;
}

InputBox:focus-within {
    border: tall #2ea043;
}

/* -- Command Suggestions (inline, above input) -- */
CommandSuggestions {
    dock: bottom;
    height: 0;
    margin: 0 2 0 2;
    display: none;
}

CommandSuggestions.visible {
    display: block;
    height: auto;
}

#suggestions-box {
    height: auto;
    max-height: 12;
    background: #f6f8fa;
    border: tall #2ea043;
    padding: 0 1;
}

#suggestions-box OptionList {
    height: auto;
    max-height: 10;
}

#suggestions-footer {
    height: 1;
    color: #656d76;
    padding: 0 1;
    text-style: italic;
}

/* -- Approval Modal -- */
ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 70%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    border: thick #ffa500;
    background: #f6f8fa;
}

#approval-title {
    text-style: bold;
    color: #ffa500;
    margin-bottom: 1;
}

#approval-action {
    color: #24292f;
}

#approval-summary {
    color: #656d76;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    align: center middle;
}

#approval-buttons Button {
    margin: 1 1 0 1;
    width: 100%;
}

/* -- Command Palette -- */
CommandPalette {
    align: center bottom;
}

#palette-container {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 22;
    background: #f6f8fa;
    border: tall #2ea043;
    padding: 0;
    margin-bottom: 4;
}

#palette-header {
    background: #2ea043 20%;
    color: #24292f;
    padding: 0 1;
    height: 1;
    text-style: bold;
}

#palette-filter {
    height: 3;
    border: tall #2ea043;
    margin: 0 1;
    padding: 0;
}

#palette-list {
    height: auto;
    max-height: 16;
    margin: 0 1;
}

#palette-list OptionList {
    height: auto;
    max-height: 16;
}

#palette-footer {
    height: 1;
    color: #656d76;
    padding: 0 1;
    text-style: italic;
}