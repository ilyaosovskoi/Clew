<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Clew is NOT sandboxed, so most entitlements are N/A.
         This file is still applied at code-sign time so that:
         - the JIT/hardened-runtime exceptions we DO need are explicit
         - future sandboxing (if we add it) only needs to flip one flag

         With ad-hoc signing (no Apple Developer account), Gatekeeper
         will still warn the user on first launch. They can bypass with
         right-click → Open, or System Settings → Privacy & Security →
         "Open Anyway". -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- MLX + torch ship native dylibs that aren't signed by Apple,
         so we have to disable library validation. With a real Developer
         ID certificate you'd re-enable this and notarize the dylibs. -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
    <key>com.apple.security.device.camera</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <false/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
